# Copy to .env and adjust. Every setting can also be set as an environment variable.

# The kiosk (12 GB VRAM): the model chosen after the comparison of October 2026.
TOTEM_LLM_MODEL=gemma4:12b
TOTEM_EMBED_MODEL=bge-m3
# Embeddings on the CPU leave the VRAM to the LLM: answers start 2-3 times sooner.
TOTEM_EMBED_ON_CPU=true

# Development laptop (4 GB VRAM):
# TOTEM_LLM_MODEL=qwen3.5:4b
